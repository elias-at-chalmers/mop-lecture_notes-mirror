{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Render Markdown to Modern HTML",
        "type": "shell",
        "command": "pandoc",
        "args": [
          "${file}",
          "-o",
          "${fileDirname}/${fileBasenameNoExtension}.html",
          "--template=template.html",
          "--metadata",
          "title=${fileBasenameNoExtension}"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [],
        "presentation": {
          "echo": true,
          "reveal": "silent",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": true,
          "clear": false
        }
      }
    ]
  }