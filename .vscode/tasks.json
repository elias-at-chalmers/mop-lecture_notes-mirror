{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Markdown to HTML",
            "type": "shell",
            "command": "pandoc",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}/../html/${fileBasenameNoExtension}.html",
                "--lua-filter=quickguide-generator/include-html.lua",
                "--standalone",
                "--css",
                "../style.css",
                "--ascii"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
